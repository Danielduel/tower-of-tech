{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "tasks": {
    "migrate": "deno run -A ./src/tools/migrate.ts",
    "migrate:readme": "deno run -A ./src/tools/migrateReadme.ts",
    "migrate:installation": "deno run -A ./src/tools/migrateInstallation.ts",
    "migrate:md": "deno run -A ./src/tools/migratePlaylistsMd.ts",
    "release": "deno run -A ./src/tools/releaseTagMessage.ts"
  },
  "importMap": "importMap.jsonc",
  "fmt": {
    "exclude": [
      ".ultra"
    ],
    "options": {
      "lineWidth": 120,
      "indentWidth": 2,
      "useTabs": false
    }
  },
  "workspace": [
    "packages/api-steam",
    "packages/db-schema"
    // "packages/*"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "nodeModuleDir": true,
  "lint": {
    "exclude": [
      ".ultra"
    ],
    "rules": {
      "exclude": [
        "no-case-declarations",
        "no-namespace"
      ]
    }
  }
}
